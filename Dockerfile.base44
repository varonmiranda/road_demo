# Dependencies only. The application source is bind-mounted by docker-compose.base44.yml and never
# baked into the image, so edits to the repo take effect without a rebuild.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
